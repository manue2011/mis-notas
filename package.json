{
  "name": "libreta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:migrate:prod": "node scripts/with-production-db.mjs npx drizzle-kit migrate",
    "admin:create:prod": "node scripts/with-production-db.mjs node scripts/create-admin.mjs",
    "auth:generate": "node --env-file=.env.local node_modules/auth/dist/index.mjs generate --config src/lib/auth/auth.ts --output src/db/schema/auth.ts",
    "realtime:build": "node realtime/build.mjs",
    "realtime:start": "node --enable-source-maps realtime/dist/server.mjs",
    "realtime:dev": "npm run realtime:build && node --env-file=.env.local --enable-source-maps realtime/dist/server.mjs"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.57.0",
    "@blocknote/code-block": "^0.57.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@blocknote/server-util": "^0.57.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.9.1",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.13",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
